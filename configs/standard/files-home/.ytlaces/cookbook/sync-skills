#!/usr/bin/env python3
# SUMMARY: bidirectionally sync ~/.agents/skills with a remote host
import argparse
import os
from pathlib import Path
import shlex
import shutil
import subprocess
import sys
from typing import Callable, Iterable, List, Optional, Sequence, Set, Tuple

LOCAL_DIR = Path.home() / ".agents" / "skills"
REMOTE_DIR = "~/.agents/skills"


# --- Pure Functions ---


def filter_skill_names(names: Iterable[str]) -> Set[str]:
    """Filter out empty lines and hidden directories (starting with .)."""
    return {name.strip() for name in names if name.strip() and not name.strip().startswith(".")}


def filter_paths(paths: Iterable[str]) -> Set[str]:
    """Filter out empty lines and paths containing hidden components (starting with .)."""
    result = set()
    for path in paths:
        cleaned = path.strip()
        if cleaned.startswith("./"):
            cleaned = cleaned[2:]
        if not cleaned:
            continue
        parts = Path(cleaned).parts
        if not any(part.startswith(".") for part in parts):
            result.add(cleaned)
    return result


def is_subpath_of_any(path: str, parent_dirs: Iterable[str]) -> bool:
    """Check if path is identical to or inside any of the parent directories."""
    for parent in parent_dirs:
        if path == parent or path.startswith(parent + "/"):
            return True
    return False


def parse_remote_find_output(output: str) -> Tuple[Set[str], Set[str]]:
    """Parse output of remote find command into (directories, files)."""
    lines = output.splitlines()
    if "---" in lines:
        sep_index = lines.index("---")
        raw_dirs = lines[:sep_index]
        raw_files = lines[sep_index + 1:]
    else:
        raw_dirs = lines
        raw_files = []
    return filter_paths(raw_dirs), filter_paths(raw_files)


def compute_skill_diff(local_skills: Set[str], remote_skills: Set[str]) -> Tuple[List[str], List[str]]:
    """Return sorted lists of local-only and remote-only names."""
    return sorted(local_skills - remote_skills), sorted(remote_skills - local_skills)


def parse_action(choice: str) -> str:
    """Parse user choice string, returning 'copy' or 'delete'."""
    lowered = choice.strip().lower()
    if lowered in ("c", "copy"):
        return "copy"
    if lowered in ("d", "delete"):
        return "delete"
    return ""


def parse_args(args: Optional[Sequence[str]] = None) -> argparse.Namespace:
    """Parse command line arguments."""
    parser = argparse.ArgumentParser(
        description="Bidirectionally sync ~/.agents/skills with a remote host."
    )
    parser.add_argument("remote_host", help="Remote host to sync skills with (e.g. cruise)")
    return parser.parse_args(args)


# --- State-Modifying Functions / Wrappers ---


def get_local_skills(directory: Path) -> Set[str]:
    """Return set of skill directory names from local path."""
    if not directory.exists():
        return set()
    return filter_skill_names(entry.name for entry in directory.iterdir())


def get_remote_skills(remote_host: str, remote_dir: str) -> Set[str]:
    """Return set of skill directory names from remote host using SSH."""
    clean_dir = remote_dir.rstrip("/")
    if clean_dir.startswith("~/"):
        remote_target = f"~/{shlex.quote(clean_dir[2:])}"
    else:
        remote_target = shlex.quote(clean_dir)
    cmd = ["ssh", remote_host, f"mkdir -p {remote_target} && ls -1A {remote_target}"]
    output = subprocess.check_output(cmd, text=True)
    return filter_skill_names(output.splitlines())


def get_local_entries(directory: Path) -> Tuple[Set[str], Set[str]]:
    """Return sets of (directory_relative_paths, file_relative_paths) from local directory."""
    if not directory.exists():
        return set(), set()
    dirs = set()
    files = set()
    for root, dirnames, filenames in os.walk(directory):
        dirnames[:] = [d for d in dirnames if not d.startswith(".")]
        rel_root = Path(root).relative_to(directory)
        for d in dirnames:
            rel_dir = str(rel_root / d) if rel_root != Path(".") else d
            dirs.add(rel_dir)
        for f in filenames:
            if not f.startswith("."):
                rel_file = str(rel_root / f) if rel_root != Path(".") else f
                files.add(rel_file)
    return dirs, files


def get_remote_entries(remote_host: str, remote_dir: str) -> Tuple[Set[str], Set[str]]:
    """Return sets of (directory_relative_paths, file_relative_paths) from remote host using SSH."""
    clean_dir = remote_dir.rstrip("/")
    if clean_dir.startswith("~/"):
        remote_target = f"~/{shlex.quote(clean_dir[2:])}"
    else:
        remote_target = shlex.quote(clean_dir)
    cmd = [
        "ssh",
        remote_host,
        f"mkdir -p {remote_target} && cd {remote_target} && find . -mindepth 1 -type d && echo '---' && find . -mindepth 1 ! -type d",
    ]
    output = subprocess.check_output(cmd, text=True)
    return parse_remote_find_output(output)


def delete_local_skill(skill_path: Path) -> None:
    """Delete a skill directory from local filesystem."""
    print(f"==> Deleting local skill: {skill_path.name}")
    if skill_path.is_dir() and not skill_path.is_symlink():
        shutil.rmtree(skill_path)
    elif skill_path.exists() or skill_path.is_symlink():
        skill_path.unlink()


def delete_remote_skill(remote_host: str, remote_dir: str, skill_name: str) -> None:
    """Delete a skill directory on remote host using SSH."""
    print(f"==> Deleting remote skill on {remote_host}: {skill_name}")
    quoted_path = f"{remote_dir.rstrip('/')}/{shlex.quote(skill_name)}"
    subprocess.run(["ssh", remote_host, f"rm -rf {quoted_path}"], check=True)


def delete_local_file(file_path: Path, rel_path: Optional[str] = None) -> None:
    """Delete a file from local filesystem."""
    display_name = rel_path or file_path.name
    print(f"==> Deleting local file: {display_name}")
    if file_path.is_dir() and not file_path.is_symlink():
        shutil.rmtree(file_path)
    elif file_path.exists() or file_path.is_symlink():
        file_path.unlink()


def delete_remote_file(remote_host: str, remote_dir: str, file_name: str) -> None:
    """Delete a file on remote host using SSH."""
    print(f"==> Deleting remote file on {remote_host}: {file_name}")
    quoted_path = f"{remote_dir.rstrip('/')}/{shlex.quote(file_name)}"
    subprocess.run(["ssh", remote_host, f"rm -rf {quoted_path}"], check=True)


def delete_local_dir(dir_path: Path, rel_path: Optional[str] = None) -> None:
    """Delete a directory from local filesystem."""
    display_name = rel_path or dir_path.name
    print(f"==> Deleting local directory: {display_name}")
    if dir_path.is_dir() and not dir_path.is_symlink():
        shutil.rmtree(dir_path)
    elif dir_path.exists() or dir_path.is_symlink():
        dir_path.unlink()


def delete_remote_dir(remote_host: str, remote_dir: str, dir_name: str) -> None:
    """Delete a directory on remote host using SSH."""
    print(f"==> Deleting remote directory on {remote_host}: {dir_name}")
    quoted_path = f"{remote_dir.rstrip('/')}/{shlex.quote(dir_name)}"
    subprocess.run(["ssh", remote_host, f"rm -rf {quoted_path}"], check=True)


def prompt_action(
    item: str,
    missing_on: str,
    input_func: Callable[[str], str] = input,
    item_type: str = "Skill",
) -> str:
    """Prompt user until they choose to copy or delete a missing skill or file."""
    prompt_text = f"{item_type} '{item}' is missing on {missing_on}. [c]opy or [d]elete? "
    while True:
        action = parse_action(input_func(prompt_text))
        if action:
            return action
        print("Invalid choice. Enter 'c' to copy or 'd' to delete.")


def sync_skills(
    remote_host: str,
    local_dir: Path = LOCAL_DIR,
    remote_dir: str = REMOTE_DIR,
    input_func: Callable[[str], str] = input,
) -> None:
    """Synchronize skills and files between local machine and remote host."""
    local_dir.mkdir(parents=True, exist_ok=True)
    clean_dir = remote_dir.rstrip("/")
    if clean_dir.startswith("~/"):
        remote_target = f"~/{shlex.quote(clean_dir[2:])}"
    else:
        remote_target = shlex.quote(clean_dir)
    subprocess.run(["ssh", remote_host, f"mkdir -p {remote_target}"], check=True)

    local_dirs, local_files = get_local_entries(local_dir)
    remote_dirs, remote_files = get_remote_entries(remote_host, remote_dir)

    local_only_dirs, remote_only_dirs = compute_skill_diff(local_dirs, remote_dirs)
    local_only_files, remote_only_files = compute_skill_diff(local_files, remote_files)

    local_only_dirs.sort(key=lambda p: (p.count("/"), p))
    remote_only_dirs.sort(key=lambda p: (p.count("/"), p))

    # Handle local items missing on remote
    handled_local_dirs: Set[str] = set()
    for d in local_only_dirs:
        if is_subpath_of_any(d, handled_local_dirs):
            continue
        item_type = "Skill" if "/" not in d else "Directory"
        action = prompt_action(d, missing_on=remote_host, input_func=input_func, item_type=item_type)
        handled_local_dirs.add(d)
        if action == "delete":
            if "/" not in d:
                delete_local_skill(local_dir / d)
            else:
                delete_local_dir(local_dir / d, rel_path=d)

    for f in local_only_files:
        if is_subpath_of_any(f, handled_local_dirs):
            continue
        action = prompt_action(f, missing_on=remote_host, input_func=input_func, item_type="File")
        if action == "delete":
            delete_local_file(local_dir / f, rel_path=f)

    # Handle remote items missing on local
    handled_remote_dirs: Set[str] = set()
    for d in remote_only_dirs:
        if is_subpath_of_any(d, handled_remote_dirs):
            continue
        item_type = "Skill" if "/" not in d else "Directory"
        action = prompt_action(d, missing_on="local", input_func=input_func, item_type=item_type)
        handled_remote_dirs.add(d)
        if action == "delete":
            if "/" not in d:
                delete_remote_skill(remote_host, remote_dir, d)
            else:
                delete_remote_dir(remote_host, remote_dir, d)

    for f in remote_only_files:
        if is_subpath_of_any(f, handled_remote_dirs):
            continue
        action = prompt_action(f, missing_on="local", input_func=input_func, item_type="File")
        if action == "delete":
            delete_remote_file(remote_host, remote_dir, f)

    print(f"==> Syncing: Local -> {remote_host} (updating newer/missing files)...")
    subprocess.run(
        ["rsync", "-avzuh", "--progress", f"{local_dir}/", f"{remote_host}:{remote_dir}/"],
        check=True,
    )

    print(f"==> Syncing: {remote_host} -> Local (updating newer/missing files)...")
    subprocess.run(
        ["rsync", "-avzuh", "--progress", f"{remote_host}:{remote_dir}/", f"{local_dir}/"],
        check=True,
    )

    print(f"==> Skills sync with {remote_host} complete!")


def main() -> None:
    args = parse_args()
    try:
        sync_skills(args.remote_host)
    except KeyboardInterrupt:
        sys.exit(130)


if __name__ == "__main__":
    main()

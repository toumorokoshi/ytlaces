#!/usr/bin/env python3
# SUMMARY: auto fold changes
#
"""
autofold merges changes to specific files tracked in git to their nearest commit
 in the history, ensuring a clean history of changes without having to interming
le multiple changes to the same file.

This helps, for exmaple, for stacked changes in branches such as graphite: in th
is case you may have a modification to a file A that is in an upstream branch. N
ormally, you would have to do the following:

1. make the change via `git commit --fixup {sha_of_commit}`, to create a fixup c
ommit.
2. run `git rebase --autosquash {sha_of_commit}`, to merge the commit upstream.

This script automates that, by doing the following:

1. looking at the modified files
2. for each file, add it and create a fixup commit of the nearest ancestor which
 modified that file.
3. run `git rebase --autosquash` on all commits which have a fixup commit, which
 will rewrite the history and merge in the changes to the follow.
"""

import subprocess
import sys
from pathlib import Path


def run_git_command(args, check=True):
    """Run a git command and return the output."""
    result = subprocess.run(
        ["git"] + args,
        capture_output=True,
        text=True,
        check=check
    )
    return result


def get_modified_files():
    """Get list of modified files in the working directory.

    Returns a list of tuples: (filepath, oldpath_or_none)
    - filepath: the current path of the file
    - oldpath_or_none: the old path for renames/copies, None otherwise
      (used to search history when the new path doesn't exist yet)
    """
    result = run_git_command(["status", "--porcelain"])
    files = []
    for line in result.stdout.strip().split("\n"):
        if not line:
            continue
        # Format: "XY filepath" where X=index status, Y=working-tree status
        # For renames/copies: "R200 oldpath -> newpath" or "R oldpath -> newpath"
        # For untracked: "?? filepath"
        status = line[:2].strip()
        if status in ("R", "C"):
            # Rename/copy format: "R[NNN] oldpath -> newpath" or "R oldpath -> newpath"
            # Extract the old and new paths
            parts = line.split(None, 2)
            # parts[0] = status (e.g., "R200" or "R")
            # parts[1] = old path
            # parts[2] = "-> newpath"
            if len(parts) >= 3:
                oldpath = parts[1]
                newpath = parts[2]
                if newpath.startswith("-> "):
                    newpath = newpath[3:]
            elif len(parts) == 2:
                oldpath = parts[1]
                newpath = parts[1]
            else:
                continue
            # Renames are already staged; use oldpath for history lookup
            files.append((newpath, oldpath))
        elif status == "??":
            # Untracked files - skip them since they have no commit history
            # to fixup against. They should be committed normally first.
            continue
        else:
            # Normal format: status + space + filepath
            # Use split to handle both " M file" and "M file" formats
            parts = line.split(None, 1)
            if len(parts) < 2:
                continue
            filepath = parts[1]
            files.append((filepath, None))

    return files


def find_nearest_commit(filepath, oldpath=None):
    """Find the nearest commit that modified the file, searching all branches.

    For renamed files, search using the old path first (since the new path
    won't exist in history yet), then fall back to the new path.
    """
    # For renames, try the old path first (it exists in history)
    search_paths = [oldpath, filepath] if oldpath else [filepath]
    for path in search_paths:
        result = run_git_command(
            ["log", "--all", "--follow", "-1", "--format=%H", "--", path],
            check=False
        )
        if result.returncode == 0 and result.stdout.strip():
            return result.stdout.strip()
    return None


def create_fixup_commit(filepath, oldpath=None):
    """Stage and create a fixup commit for the file."""
    # Check if already staged (e.g. renames from git mv)
    result = run_git_command(["diff", "--cached", "--name-only"], check=False)
    staged_files = result.stdout.strip().split("\n") if result.stdout.strip() else []
    is_staged = filepath in staged_files

    # Stage the file if not already staged
    if not is_staged:
        run_git_command(["add", filepath])

    # Find the nearest commit for this file (use oldpath for renames)
    commit_sha = find_nearest_commit(filepath, oldpath)
    if not commit_sha:
        print(f"Warning: No commit found for file: {filepath}")
        return None

    # Create fixup commit
    # For renames (already staged), commit without pathspec so the rename
    # operation itself is included in the commit. For normal changes, use
    # pathspec to only commit the specific file.
    if is_staged:
        result = run_git_command(["commit", "--fixup", commit_sha])
    else:
        result = run_git_command(["commit", "--fixup", commit_sha, "--", filepath])

    if result.returncode == 0:
        print(f"Created fixup commit for {filepath} -> {commit_sha[:8]}")
        return commit_sha
    return None


def run_autosquash_rebase():
    """Run autosquash rebase on all fixup commits."""
    # Try to find upstream
    result = run_git_command(["rev-parse", "@{u}"], check=False)
    if result.returncode == 0:
        upstream_sha = result.stdout.strip()
        print(f"Running autosquash rebase onto upstream {upstream_sha[:8]}...")
        result = run_git_command([
            "rebase", "--autosquash", upstream_sha
        ], check=False)
    else:
        # No upstream - rebase from root so that fixup commits can squash
        # into any commit in the history (including early commits that would
        # be excluded if we rebased onto a branch tip).
        print("Running autosquash rebase from root...")
        result = run_git_command([
            "rebase", "--autosquash", "--root"
        ], check=False)

    if result.returncode != 0:
        print(f"Rebase error: {result.stderr.strip()}")
    return result.returncode == 0


def main():
    """Main entry point."""
    # Check if we're in a git repository
    if not Path(".git").exists():
        print("Error: Not in a git repository")
        sys.exit(1)

    # Get modified files
    modified_files = get_modified_files()

    if not modified_files:
        print("No modified files to commit")
        sys.exit(0)

    print(f"Found {len(modified_files)} modified file(s)")

    # Create fixup commits for each file
    fixup_created = False
    for filepath, oldpath in modified_files:
        if create_fixup_commit(filepath, oldpath):
            fixup_created = True

    # Only run rebase if we actually created fixup commits
    if not fixup_created:
        print("No fixup commits created - nothing to rebase")
        sys.exit(0)

    # Run autosquash rebase
    success = run_autosquash_rebase()

    if success:
        print("Autosquash rebase completed successfully")
    else:
        print("Autosquash rebase failed - you may need to resolve conflicts")
        sys.exit(1)


if __name__ == "__main__":
    main()
